
#include <stdio.h>
#include <stdlib.h>

// Estrutura do nó
typedef struct No {
    int valor;
    struct No *anterior;
    struct No *proximo;
} No;

// Estrutura da lista
typedef struct {
    No *inicio;
    No *fim;
    int tamanho;
} Lista;

// Inicializa a lista
void inicializarLista(Lista *lista) {
    lista->inicio = NULL;
    lista->fim = NULL;
    lista->tamanho = 0;
}

// Cria um novo nó
No* criarNo(int valor) {
    No *novo = (No*) malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro ao alocar memoria!\n");
        exit(1);
    }

    novo->valor = valor;
    novo->anterior = NULL;
    novo->proximo = NULL;

    return novo;
}

// Inserir no início
void inserirInicio(Lista *lista, int valor) {
    No *novo = criarNo(valor);

    if (lista->inicio == NULL) {
        // Lista vazia
        lista->inicio = novo;
        lista->fim = novo;
    } else {
        novo->proximo = lista->inicio;
        lista->inicio->anterior = novo;
        lista->inicio = novo;
    }
    lista->tamanho++;

    printf("Valor inserido no inicio com sucesso!\n");
}

// Inserir no final
void inserirFinal(Lista *lista, int valor) {
    No *novo = criarNo(valor);

    if (lista->fim == NULL) {
        // Lista vazia
        lista->inicio = novo;
        lista->fim = novo;
    } else {
        novo->anterior = lista->fim;
        lista->fim->proximo = novo;
        lista->fim = novo;
    }

    lista->tamanho++;

    printf("Valor inserido no final com sucesso!\n");
}

// Inserir em uma posição específica
void inserirPosicao(Lista *lista, int valor, int posicao) {

    if (posicao < 1 || posicao > lista->tamanho + 1) {
        printf("Posicao invalida!\n");
        return;
    }

    // Se for a primeira posição
    if (posicao == 1) {
        inserirInicio(lista, valor);
        return;
    }

    // Se for a última posição
    if (posicao == lista->tamanho + 1) {
        inserirFinal(lista, valor);
        return;
    }

    No *novo = criarNo(valor);
    No *atual = lista->inicio;

    // Percorre até o nó que ficará depois do novo
    for (int i = 1; i < posicao; i++) {
        atual = atual->proximo;
    }


    novo->proximo = atual;
    novo->anterior = atual->anterior;

    atual->anterior->proximo = novo;
    atual->anterior = novo;

    lista->tamanho++;

    printf("Valor inserido na posicao %d com sucesso!\n", posicao);
}

// Remover uma posição específica
void remover(Lista *lista, int posicao) {

    if (lista->inicio == NULL) {
        printf("A lista esta vazia!\n");
        return;
    }

    if (posicao < 1 || posicao > lista->tamanho) {
        printf("Posicao invalida!\n");
        return;
    }

    No *atual = lista->inicio;

    // Percorre até a posição desejada
    for (int i = 1; i < posicao; i++) {
        atual = atual->proximo;
    }

    // Se existir um nó anterior
    if (atual->anterior != NULL) {
        atual->anterior->proximo = atual->proximo;
    } else {
        // Removendo o primeiro nó
        lista->inicio = atual->proximo;
    }

    // Se existir um próximo nó
    if (atual->proximo != NULL) {
        atual->proximo->anterior = atual->anterior;
    } else {
        // Removendo o último nó
        lista->fim = atual->anterior;
    }

    printf("Valor %d removido da posicao %d.\n",
           atual->valor, posicao);

    free(atual);

    lista->tamanho--;
}

// Buscar um valor
int buscar(Lista *lista, int valor) {

    No *atual = lista->inicio;
    int posicao = 1;

    while (atual != NULL) {

        if (atual->valor == valor) {
            return posicao;
        }

        atual = atual->proximo;
        posicao++;
    }

    return -1;
}

// Listar a lista
void listar(Lista *lista) {

    if (lista->inicio == NULL) {
        printf("\nA lista esta vazia!\n");
        return;
    }

    No *atual = lista->inicio;
    int posicao = 1;

    printf("\n========== LISTA ==========\n");

    while (atual != NULL) {

        printf("\nPosicao: %d\n", posicao);
        printf("Valor: %d\n", atual->valor);

        if (atual->anterior != NULL) {
            printf("Anterior: %d\n", atual->anterior->valor);
        } else {
            printf("Anterior: NULL\n");
        }

        if (atual->proximo != NULL) {
            printf("Proximo: %d\n", atual->proximo->valor);
        } else {
            printf("Proximo: NULL\n");
        }

        printf("---------------------------\n");

        atual = atual->proximo;
        posicao++;
    }


    printf("Tamanho da lista: %d\n", lista->tamanho);
}

// Libera toda a memória da lista
void liberarLista(Lista *lista) {

    No *atual = lista->inicio;

    while (atual != NULL) {
        No *proximo = atual->proximo;
        free(atual);
        atual = proximo;
    }

    lista->inicio = NULL;
    lista->fim = NULL;
    lista->tamanho = 0;
}

// Menu principal
int main() {

    Lista lista;
    inicializarLista(&lista);

    int opcao;
    int valor;
    int posicao;

    do {

        printf("\n==============================\n");
        printf("   LISTA DUPLAMENTE ENCADEADA\n");
        printf("==============================\n");
        printf("1 - Inserir no inicio\n");
        printf("2 - Inserir em uma posicao\n");
        printf("3 - Inserir no final\n");
        printf("4 - Remover\n");
        printf("5 - Buscar\n");
        printf("6 - Listar\n");
        printf("0 - Sair\n");
        printf("==============================\n");

        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {

            case 1:
                printf("Digite o valor: ");
                scanf("%d", &valor);

                inserirInicio(&lista, valor);
                break;

            case 2:
                printf("Digite o valor: ");
                scanf("%d", &valor);

                printf("Digite a posicao (1 a %d): ",
                       lista.tamanho + 1);
                scanf("%d", &posicao);

                inserirPosicao(&lista, valor, posicao);
                break;

            case 3:
                printf("Digite o valor: ");
                scanf("%d", &valor);

                inserirFinal(&lista, valor);
                break;

            case 4:
                if (lista.tamanho == 0) {
                    printf("A lista esta vazia!\n");
                    break;
                }

                printf("Digite a posicao que deseja remover (1 a %d): ",
                       lista.tamanho);
                scanf("%d", &posicao);

                remover(&lista, posicao);
                break;

            case 5:
                printf("Digite o valor que deseja buscar: ");
                scanf("%d", &valor);

                posicao = buscar(&lista, valor);

                if (posicao == -1) {
                    printf("Valor %d nao encontrado na lista.\n", valor);
                } else {
                    printf("Valor %d encontrado na posicao %d.\n",
                           valor, posicao);
                }
                break;

            case 6:
                listar(&lista);
                break;

            case 0:
                liberarLista(&lista);
                printf("Programa encerrado.\n");
                break;

            default:
                printf("Opcao invalida! Tente novamente.\n");
        }

    } while (opcao != 0);

    return 0;
}
